DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Set DB_ENGINE=postgresql to use PostgreSQL instead of the local SQLite database.
DB_ENGINE=postgresql
POSTGRES_DB=resume_matcher
POSTGRES_USER=resume_matcher
POSTGRES_PASSWORD=replace-this-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
